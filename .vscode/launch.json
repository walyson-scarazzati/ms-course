{
  "version": "0.2.0",
  "configurations": [
    {
        "type": "java",
        "name": "hr-worker :8001",
        "request": "launch",
        "mainClass": "com.devsuperior.hrworker.HrWorkerApplication",
        "projectName": "hr-worker",
        "vmArgs": "-Dserver.port=8001 -Dcom.sun.management.jmxremote -Dcom.sun.management.jmxremote.port=55257 -Dcom.sun.management.jmxremote.authenticate=false -Dcom.sun.management.jmxremote.ssl=false -Dspring.jmx.enabled=true -Djava.rmi.server.hostname=localhost -Dspring.application.admin.enabled=true -Dspring.boot.project.name=hr-worker"
    },
    {
        "type": "java",
        "name": "hr-worker :8002",
        "request": "launch",
        "mainClass": "com.devsuperior.hrworker.HrWorkerApplication",
        "projectName": "hr-worker",
        "vmArgs": "-Dserver.port=8002"
    },
    {
        "type": "java",
        "name": "Spring Boot-HrPayrollApplication<hr-payroll>",
        "request": "launch",
        "cwd": "${workspaceFolder}",
        "mainClass": "com.devsuperior.hrpayroll.HrPayrollApplication",
        "projectName": "hr-payroll",
        "args": "",
        "envFile": "${workspaceFolder}/.env"
    }
]
}
